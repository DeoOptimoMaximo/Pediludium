<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Health check for nogomet.domovina.ai (every 30 min) — docs/21 §2A.
     Reports out of band (ntfy) when Postgres is unreachable, ingest has gone stale, matches are
     stranded without results, or the published snapshot is aging while work is pending.
     Install: cp to ~/Library/LaunchAgents/ then
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.pediludium.health.plist
     Logs: ~/Library/Logs/pediludium/health.log
     Note: launchd skips ticks while the Mac sleeps (coalesced to one run on wake) — so this
     detects an outage on a machine that is AWAKE, which is exactly the incident it exists for. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pediludium.health</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/ms/git/DeoOptimoMaximo/Pediludium/fetcher/scripts/health-check.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/ms/Library/Logs/pediludium/health.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ms/Library/Logs/pediludium/health.log</string>
</dict>
</plist>
