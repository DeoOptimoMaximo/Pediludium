{
  "name": "pediludium-fetcher",
  "version": "0.0.1",
  "private": true,
  "description": "SofaScore ingest (residential IP) for Pediludium — World Cup 2026 data layer",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "probe": "node src/probe.ts",
    "backfill": "node src/backfill.ts",
    "history": "node src/history.ts",
    "refresh": "node src/refresh.ts",
    "scheduler": "node src/scheduler.ts",
    "predict": "node src/predict.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "dependencies": {
    "pg": "^8.21.0",
    "playwright-core": "^1.60.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
