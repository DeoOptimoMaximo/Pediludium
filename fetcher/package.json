{
  "name": "pediludium-fetcher",
  "version": "0.0.1",
  "private": true,
  "description": "SofaScore ingest (residential IP) for Pediludium — World Cup 2026 data layer",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "probe": "node src/probe.ts",
    "backfill": "node src/backfill.ts",
    "history": "node src/history.ts",
    "refresh": "node src/refresh.ts",
    "resolve:ko": "node src/resolve-knockout.ts",
    "enrich": "node src/enrich.ts",
    "scheduler": "node src/scheduler.ts",
    "predict": "node src/predict.ts",
    "predict:dc": "node src/dixon-coles.ts",
    "predict:dcm": "node src/dc-market.ts",
    "simulate": "node src/simulate.ts",
    "standings": "node src/standings.ts",
    "history:record": "node src/prediction-history.ts record",
    "history:backfill": "node src/prediction-history.ts backfill",
    "edge:pm": "node src/edge-pm.ts",
    "edge:kalshi": "node src/edge-kalshi.ts",
    "edge:books": "node src/edge-books.ts",
    "edge:scan": "node src/edge-scan.ts",
    "edge:trade": "node src/edge-trade.ts",
    "edge": "node src/edge.ts",
    "export": "node src/export-snapshot.ts",
    "snapshot": "node src/export-snapshot.ts && node src/publish-snapshot.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "edge:supersport": "node src/edge-supersport.ts",
    "edge:sofascore": "node src/edge-sofascore-odds.ts",
    "refresh:fc": "node src/refresh-firecrawl.ts",
    "health": "node src/health.ts",
    "alert:test": "node src/alert.ts"
  },
  "dependencies": {
    "pg": "^8.21.0",
    "playwright-core": "^1.60.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.99.0"
  }
}
