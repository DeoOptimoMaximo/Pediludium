# Pediludium fetcher — config (all optional; sane defaults in src/config.ts)
# Copy to .env and override only what you need. Never commit .env.

# SofaScore (unofficial) API base
SOFA_BASE_URL=https://api.sofascore.com/api/v1

# Politeness layer — be a polite human, not a bot
SOFA_DELAY_MIN_MS=1500
SOFA_DELAY_MAX_MS=4000
SOFA_MAX_RETRIES=3
SOFA_BACKOFF_MIN_MS=2000
SOFA_BACKOFF_MAX_MS=5000
# circuit breaker: after N consecutive 403/429, pause for the cooldown
SOFA_CIRCUIT_THRESHOLD=4
SOFA_CIRCUIT_COOLDOWN_MS=900000

# where the probe dumps sample JSON (gitignored)
SOFA_SAMPLE_DIR=.probe-samples
