# Pediludium fetcher — config (all optional; sane defaults in src/config.ts)
# Copy to .env and override only what you need. Never commit .env.

# SofaScore (unofficial) API base
SOFA_BASE_URL=https://api.sofascore.com/api/v1

# Politeness layer — be a polite human, not a bot
SOFA_DELAY_MIN_MS=1500
SOFA_DELAY_MAX_MS=4000
SOFA_MAX_RETRIES=3
SOFA_BACKOFF_MIN_MS=2000
SOFA_BACKOFF_MAX_MS=5000
# circuit breaker: after N consecutive 403/429, pause for the cooldown
SOFA_CIRCUIT_THRESHOLD=4
SOFA_CIRCUIT_COOLDOWN_MS=900000

# where the probe dumps sample JSON (gitignored)
SOFA_SAMPLE_DIR=.probe-samples

# ─────────────────────────────────────────────────────────────────────────────
# HEALTH / ALERTING (docs/21 §2A) — obavijest koja NE ovisi o bazi ni o Macu.
# ─────────────────────────────────────────────────────────────────────────────
# PAZI: ovaj .env NE ucitava se automatski. Vecina skripti radi na defaultima iz
# src/config.ts; samo skripte kojima treba tajna pokrecu se s
# `node --env-file-if-exists=.env ...` (health, alert:test, should-sync). Ako dodajes
# novu varijablu koja mora stvarno stici do koda, provjeri da je njen pokretac ima.
#
# ntfy.sh topic je DIJELJENA TAJNA: tko zna ime, moze citati i slati. Zato ide
# samo u .env (gitignored, konvencija secrets-zero-leakage) i nikad u repo.
# Izaberi neprozirno ime, npr. `openssl rand -hex 6` kao sufiks.
# Prazno = alarmiranje iskljuceno (health check i dalje radi i loga).
# HEALTH_NTFY_TOPIC=pediludium-ops-XXXXXX
# HEALTH_NTFY_SERVER=https://ntfy.sh
# max 1 alarm po tipu u N sati (da pad ne spamira 48 poruka dnevno)
HEALTH_ALERT_COOLDOWN_H=6
# koliko star smije biti zadnji uspjesan ingest tick prije nego pocrveni
HEALTH_STALE_REFRESH_H=6
# koliko star smije biti zadnji KV publish DOK IMA neobradenih utakmica
HEALTH_STALE_PUBLISH_H=6

# Catch-up gate (docs/21 §2B): koliko dana utakmica ostaje u opsegu provjere
# prije nego se proglasi "stranded" (alarm umjesto vjecnog trosenja kredita).
SYNC_STRANDED_AFTER_D=14
# nakon koliko uzastopnih tickova bez baze sync-gate salje alarm
SYNC_GATE_FAIL_ALERT=4

# Local Supabase Postgres (from: supabase status)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres

# Egress kroz alternativnu izvornu IP (npr. iPhone USB tether -> Telemach mobile IP)
# da zaobides ban na glavnom IP-u. Vidi docs/09. Auto-detekcija 172.20.10.x:
SOFA_VIA_IPHONE=0
# ili eksplicitno: SOFA_SOURCE_ADDR=172.20.10.13

# ─────────────────────────────────────────────────────────────────────────────
# EDGE LAYER — Web2 (HR kladionice) ↔ Web3 (Polymarket) odds, +EV/arbitraza,
# i DRY-RUN eksperiment automatiziranog otvaranja pozicija.
# ─────────────────────────────────────────────────────────────────────────────

# KLJUCNO: trader SAMO simulira dok je ovo 'true'. Postavi na 'false' tek za live.
EDGE_DRY_RUN=true

# Polymarket read (Gamma discovery + CLOB order book) — NE treba auth.
PM_GAMMA_HOST=https://gamma-api.polymarket.com
PM_CLOB_HOST=https://clob.polymarket.com
# opcionalno: zarezom odvojeni Gamma tag slugovi za brzi WC discovery (npr.
# 'soccer,fifa-world-cup'); prazno = discover uzivo preko /tags + name-match na fixtures
# PM_TAG_SLUGS=soccer,fifa-world-cup

# Polymarket TRADING (samo kad je EDGE_DRY_RUN=false) — v2 stack (od 28.4.2026, pUSD).
# PM_PRIVATE_KEY=0x...                 # L1 signer (potpisuje narudzbe; ostaje lokalno)
# PM_FUNDER_ADDRESS=0x...              # proxy/deposit adresa koja drzi pUSD (signer != funder)
# PM_SIGNATURE_TYPE=1                  # 0 EOA | 1 proxy | 2 gnosis-safe | 3 erc1271
# POLYGON_RPC_URL=https://polygon-rpc.com

# Sharp-consensus fallback (Pinnacle/Betfair WC odds) za kalibraciju
# THE_ODDS_API_KEY=...

# Engine pragovi + risk management
EDGE_MIN_EV=0.03                       # flag +EV kad je model edge >= 3%
EDGE_MIN_ARB=0.005                     # flag arb kad je zajamcena dobit >= 0.5%
EDGE_KELLY_FRACTION=0.25               # frakcijski Kelly multiplikator
EDGE_MAX_STAKE_USD=25                  # tvrdi limit po jednoj poziciji
EDGE_DAILY_LOSS_LIMIT_USD=100          # zaustavi trgovanje preko ovog dnevnog gubitka
EDGE_PAPER_BANKROLL_USD=1000           # pocetni saldo paper walleta
EDGE_MODEL_VERSION=dixon-coles-v1      # koji prediction model daje +EV referencu
